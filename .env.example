# Gemini API Key (Required for LLM extraction, scoring, and drafting)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Reddit API Credentials (Read-only access via PRAW)
# Create a free "script" app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=JobAssistantBot/1.0 by your_username

# Optional: Notifications (leave blank to display digest in CLI)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
