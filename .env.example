# Gemini API Key (Required for LLM extraction, scoring, and drafting)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Reddit API Credentials (Read-only access via PRAW)
# Create a free "script" app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=JobAssistantBot/1.0 by your_username

# Optional: one-click application emails (sent only when you click Send in the web app)
# Gmail: turn on 2-step verification, then create an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_16_character_app_password
# SMTP_FROM_NAME=Your Name

# Optional: Notifications (leave blank to display digest in CLI)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Gmail: sending applications (only when you click Send) and reading job-alert emails (read-only).
# Needs a Gmail App Password (myaccount.google.com/apppasswords, requires 2-step verification), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your 16-character app password
# Optional: read alerts from a different mailbox than you send from.
# IMAP_HOST=imap.gmail.com
# IMAP_USER=
# IMAP_PASSWORD=
